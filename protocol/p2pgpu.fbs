// p2pgpu wire schema — THE single source of truth (rule R3).
//
// flatc generates C++ headers from this file into the BUILD TREE at build
// time. Generated headers are never committed and never hand-edited.
//
// The prose specification is docs/PROTOCOL.md. If this file and that document
// disagree, one of them is a bug — fix both in the same commit
// (docs/WORKFLOW.md §6).
//
// ── WHEN YOU CHANGE THIS FILE ────────────────────────────────────────────
//   1. Additive field with a default  → no PROTOCOL_VERSION bump needed
//   2. Removal, reorder, type change  → bump PROTOCOL_VERSION + DECISIONS.md
//   3. Always: update docs/PROTOCOL.md in the same commit
//   4. Always: add a fuzz corpus seed covering the new shape (fuzz/corpus/)
//
// Step 4 is not optional. Every new message shape is new attack surface,
// and this schema is reachable by any anonymous worker on the internet.
//
// ── WHAT FLATBUFFERS DOES AND DOES NOT GIVE US ───────────────────────────
// It guarantees a verified buffer can be READ without memory corruption. It
// does NOT enforce any semantic bound: nothing here stops a worker declaring
// `output_spec.bytes = 4 GiB`. Every limit in docs/PROTOCOL.md §4 is enforced
// in code (step 1.4) against the constants in include/p2pgpu/protocol/limits.hpp.
// Treat this file as a shape, never as a validator.
//
// ── FIELD ORDER IS PART OF THE CONTRACT ──────────────────────────────────
// FlatBuffers assigns vtable slots by declaration order. APPENDING a field to
// the end of a table is free and backward-compatible. Reordering or removing
// one silently changes how old peers read new buffers. Append only.
// The same applies to enum and union members: append, never reorder.
//
// Written in Phase 1, step 1.1.

namespace p2pgpu.wire;

// ── Primitives ───────────────────────────────────────────────────────────
// Structs (not tables) for fixed-size values: inline, no vtable, no
// nullability to reason about at the trust boundary.

struct Uuid   { hi: ulong; lo: ulong; }                     // WorkerId / TaskId / JobId
struct Hash32 { a: ulong; b: ulong; c: ulong; d: ulong; }   // BLAKE3-256

/// Kernel dispatch geometry. A struct so it cannot be null or partially set.
struct WorkgroupSize { x: uint; y: uint; z: uint; }

enum DType : byte { U32, I32, F32, F16, Bytes }
enum WorkerKind : byte { Browser, Native, Mock }
enum AssetSource : byte { None, Cached, Peer, Coordinator }

// Enum values are wire values. APPEND only — renumbering silently reinterprets
// old messages. See docs/PROTOCOL.md §3.

enum ReleaseReason : byte {
  UserStopped,        // R7 stop control
  TabHidden,
  DeviceLost,         // R4 / TDR; see D-0022
  AssetUnavailable,   // the task's bulk INPUT asset (Phase 6), not its kernel
  TooSlow,
  Shutdown,
  // Appended in D-0035, and appended is the only safe position: reordering or
  // inserting silently remaps every existing value.
  KernelUnavailable,  // the granted kernel's WGSL could not be obtained
  ExecutionFailed,    // local failure that is NOT device loss: compile, limits,
                      // allocation, readback timeout
}

enum RevokeReason : byte {
  SpeculativeLoser,      // another worker won the race (step 2.17)
  JobCancelled,
  LeaseExpired,
  ValidationSuperseded,
}

enum ErrorCode : byte {
  VersionMismatch,
  UnknownKernel,
  MalformedMessage,
  OrphanPayload,        // payload_follows set with no payload, or vice versa
  PayloadTooLarge,
  ChecksumMismatch,
  LeaseNotHeld,
  RateLimited,          // connection-level, NOT reputation (step 3.11/3.12)
  Blacklisted,
  Internal,
}

// ── Determinism (rule R6) ────────────────────────────────────────────────
// Honest GPUs from different vendors disagree in the last few ULPs. This
// union decides how the validator compares replicas. Misdeclaring it causes
// honest workers to be blacklisted — see docs/RISKS.md §2.
//
// Confirmed empirically in step 0.9: naga, Tint, and WebKit produce
// bitwise-identical output for our integer kernels, so `Exact` is real and not
// merely hoped for. The cross-VENDOR case is still unmeasured (step 0.16).

table Exact {}                                        // integer path; bitwise valid

table Tolerant {
  rel_eps: float;      // |a-b| <= abs_eps + rel_eps*|b|
  abs_eps: float;      // both justified by measurement, not guessed (step 4.7)
}

/// Which distributional consistency test the validator runs. Body lands in
/// Phase 5 (step 5.14); the enum exists now so the shape is fixed.
enum StatTest : byte {
  None,
  VarianceRatio,       // sample variance vs. expected for the sample count
  ChiSquared,
  KolmogorovSmirnov,
}

table Statistical {
  test: StatTest;
  // Phase 5 appends its parameters here. Appending is free.
}

union DeterminismClass { Exact, Tolerant, Statistical }

// ── Task ─────────────────────────────────────────────────────────────────

table OutputSpec {
  bytes: uint;         // <= kMaxOutputBytes (8 MiB), invariant 2
  dtype: DType;
  /// Exact bytes the host writes into the result buffer ONCE PER TASK, before
  /// the first dispatch. Absent or empty means zero-fill.
  ///
  /// Added in D-0040. A reduction's identity element is part of WHAT THE WORK
  /// IS, so it belongs to the coordinator (R1) — `brute_search_v1` needs
  /// 0xFFFFFFFF at offset 4 as atomicMin's identity, and a worker that
  /// zero-filled instead pinned that output at 0 for every task ever run.
  ///
  /// A property of the KERNEL, not the task, so it travels in Welcome's
  /// KernelDescriptor once per connection rather than in every TaskEnvelope.
  init: [ubyte];
}

table AccumulationSpec {
  upload_interval_ms: uint;    // >= 500 (invariant 7) — more often defeats R5
  min_iterations:     ulong;   // derived from the R5 calculation, never guessed
}

table TaskEnvelope {
  task_id:     Uuid;
  job_id:      Uuid;
  kernel_id:   string;          // key into kernels/manifest.toml
  seed:        ulong;           // with the unit range, fixes the work (K2)
  params:      [ubyte];         // uniform buffer bytes; <= 4 KiB (invariant 1)
  /// First unit of this task's range. THE AUTHORITY (D-0041).
  ///
  /// The params blob also carries a (start, count) chunk window at bytes 0-7
  /// per D-0033 — but the host OVERWRITES those every dispatch, so they are
  /// scratch space, not a source of truth. Before this field existed the worker
  /// decoded the base from them, and `start_unit = 0` looked plausible enough
  /// to survive review: every task in a 1000-task job searched the same range
  /// while the coordinator recorded full coverage (D-0040).
  ///
  /// 64-bit deliberately. Task starts are 64-bit internally while the chunk
  /// window is u32, so the wire could not previously express a range the
  /// coordinator can represent.
  start_unit:  ulong;
  work_units:  ulong;           // sizer output; meaning is kernel-defined
  input_ref:   Hash32;          // optional; absent => no bulk input
  output_spec: OutputSpec;
  lease_ms:    uint;
  replica_of:  Uuid;            // optional; set => this is a verification replica
  accumulate:  AccumulationSpec;
}

// ── Worker description ───────────────────────────────────────────────────

table GpuLimits {
  max_storage_buffer_binding_size:    ulong;
  max_buffer_size:                    ulong;
  max_compute_workgroups_per_dim:     uint;
  max_compute_invocations_per_group:  uint;
  max_compute_workgroup_storage_size: uint;
}

/// Identity strings are ADVISORY ONLY.
///
/// Measured in steps 0.6/0.8/0.13: the same physical GPU reports three
/// different things depending on implementation — native gives
/// `(empty)/(empty)/Apple M4 Pro`, Chromium `apple/metal-3/(empty)`, Safari
/// `apple/apple/apple`. Never key scheduling or validation on these; never
/// assume non-empty (docs/RISKS.md §1).
table AdapterInfo {
  vendor:       string;
  architecture: string;
  device:       string;
  backend:      string;    // "metal" | "vulkan" | "d3d12" | "webgpu" | ...
}

table WorkerCapabilities {
  kind:            WorkerKind;
  user_agent:      string;
  adapter:         AdapterInfo;
  features:        [string];    // "shader-f16", "subgroups", "timestamp-query"
  limits:          GpuLimits;
  supports_webrtc: bool;
}

/// Telemetry only — never an input to correctness or credit (invariant 8).
/// A worker controls every number here and can lie about all of them.
/// Every field feeds EVALUATION.md E2, so populate all of them.
table TaskStats {
  gpu_ms:       double;
  transfer_ms:  double;
  idle_ms:      double;
  dispatches:   uint;
  iterations:   ulong;
  asset_source: AssetSource;
}

/// What the coordinator tells a worker about a kernel it may be asked to run.
/// Mirrors kernels/manifest.toml (docs/KERNELS.md §2); the WGSL itself is
/// fetched separately by id over HTTP (step 1.12).
table KernelDescriptor {
  kernel_id:        string;
  entry_point:      string;
  workgroup_size:   WorkgroupSize;
  determinism:      DeterminismClass;
  output:           OutputSpec;
  accumulates:      bool;
  min_iterations:   ulong;
  flop_per_unit:    ulong;      // for the sizer and the R5 audit trail
}

/// A peer the data plane may try to fetch from (Phase 6).
///
/// NO `has_assets: [Hash32]` — see D-0028. Two reasons, and they agree:
///
///  1. SAFETY. flatbuffers::Verifier does not check the alignment of
///     vector-of-struct element data, so a crafted buffer could place a
///     [Hash32] at a 4-aligned offset, pass verification, and hand us
///     misaligned u64 reads. Found by the step 1.5 fuzzer, attacker-craftable.
///
///  2. LAYERING. The coordinator already tracks which peers hold which hashes
///     (step 6.12) and is the only component allowed to make decisions (R1).
///     It therefore sends a peer list ALREADY FILTERED to peers holding what
///     this worker needs. Shipping raw hashes so the worker could filter would
///     duplicate coordinator state onto an untrusted party to no benefit.
table PeerInfo {
  worker_id: Uuid;
}

// ── Messages: worker → coordinator ───────────────────────────────────────

table Hello {
  /// Also present in the fixed frame header, which is checked BEFORE the
  /// Verifier runs (docs/PROTOCOL.md §1). Deliberate redundancy: the header
  /// check is the cheap pre-parse gate, this one is inside the verified region.
  protocol_version: uint;
  resume_token:     string;     // a prior Welcome.session_token; optional
  capabilities:     WorkerCapabilities;

  /// Bulk assets this worker already holds, as 64-char lowercase hex (5.18).
  ///
  /// APPENDED in D-0079, and `[string]` rather than the obvious `[Hash32]`
  /// because **vectors of structs are BANNED on this wire** (D-0028): the
  /// Verifier does not check alignment of vector-of-struct element data, which
  /// made `[Hash32]` an attacker-craftable misaligned read that passed
  /// verification. A vector of strings is a vector of offsets and is checked
  /// completely.
  ///
  /// ADVISORY. A worker claiming to hold an asset it does not have gets a task
  /// it must then fetch anyway; a worker under-reporting loses affinity. Neither
  /// is a correctness question, which is why a malformed entry is dropped rather
  /// than rejected.
  cached_assets:    [string];
}

table BenchmarkResult {
  kernel_id: string;
  score:     double;    // normalized work-units/sec
  samples:   uint;
}

table LeaseRequest {
  max_tasks: uint;      // pull-based (D-0005). The worker asks WHETHER,
                        // never HOW MUCH — sizing is the coordinator's (R1).

  /// What this worker holds RIGHT NOW, 64-char lowercase hex (5.18, D-0079).
  ///
  /// Also on `Hello`, and that copy is nearly useless on its own: the handshake
  /// always precedes every fetch, so a connecting worker truthfully reports an
  /// empty cache and never mentions it again. Measured as 0% affinity before
  /// this field existed.
  ///
  /// `[string]` not `[Hash32]` — vectors of structs are banned on this wire
  /// (D-0028).
  cached_assets: [string];
}

table Progress {
  task_id:       Uuid;
  fraction_done: float;
  request_renew: bool;   // doubles as the heartbeat for this lease
}

/// The bulk payload rides OUTSIDE the FlatBuffer, in the same frame
/// (docs/PROTOCOL.md §1). Verifying 8 MiB of GPU output buys nothing, since
/// its interpretation is fully determined by OutputSpec.
table ResultHeader {
  task_id:       Uuid;
  payload_bytes: uint;    // <= kMaxOutputBytes; MUST equal the actual trailing
                          // bytes (invariant 2, and the Heartbleed shape)
  checksum:      ulong;   // BLAKE3-64 of the payload. Mismatch => requeue with
                          // NO reputation penalty (invariant 9) — corruption is
                          // not malice.
  stats:         TaskStats;

  // ── Appended in D-0074 (step 5.13). APPENDED, never inserted: FlatBuffers
  //    assigns vtable slots positionally and a reorder silently remaps every
  //    existing field (D-0035 learned this on ReleaseReason).

  /// Ordering key for partial uploads, strictly increasing per (task, worker).
  /// 0 for a one-shot result.
  ///
  /// Separate from `units_done` on purpose. Ordering and weighting are
  /// different questions: `units_done` is what 5.15 weights a tile by, this is
  /// what says which of two snapshots arrived later. They happen to agree for
  /// an accumulating kernel; a kernel whose partials are not monotonic in any
  /// natural quantity would otherwise leave no ordering key at all.
  ///
  /// A LOWER-OR-EQUAL sequence is DROPPED. Out-of-order delivery is normal
  /// after a reconnect, and a stale snapshot replacing a newer one rolls a tile
  /// backwards — an image that un-converges, which is miserable to diagnose.
  sequence:      uint;

  /// Units this result accounts for. **0 means "all of `work_units`"**, i.e.
  /// the result is complete.
  ///
  /// The default has to mean "complete" because every message already on the
  /// wire omits this field and every one of them IS complete. A default of
  /// literal zero would make every brute_search result claim it did no work.
  ///
  /// A partial carries the FULL accumulator so far, never a delta: merging
  /// deltas would need the coordinator to know the payload's arithmetic, which
  /// is kernel-specific knowledge R1 keeps out of it.
  units_done:    ulong;
}

table Release {
  task_id: Uuid;
  reason:  ReleaseReason;   // voluntary give-back; never a reputation penalty
}

table Throttle {
  level: float;   // 0.0-1.0, user-set (R7). The coordinator adjusts sizing and
                  // does not argue — the user's setting is authoritative.
}

table Goodbye {
  reason: ReleaseReason;   // clean disconnect; all leases released
}

// ── Messages: coordinator → worker ───────────────────────────────────────

table Welcome {
  worker_id:     Uuid;
  session_token: string;         // present later in Hello.resume_token.
                                 // Resume restores reputation and benchmark
                                 // score but NEVER leases — those expired when
                                 // the connection dropped (R8).
  heartbeat_ms:  uint;
  kernels:       [KernelDescriptor];
}

table BenchmarkRequest {
  kernel_id: string;
  target_ms: uint;
}

/// One task per message. Granting fewer than requested means sending fewer
/// messages, which keeps this shape simple and the lease bookkeeping 1:1.
table TaskGrant {
  envelope: TaskEnvelope;
}

table LeaseAck {
  task_id:       Uuid;
  expires_at_ms: ulong;   // ABSOLUTE, on the COORDINATOR's clock. Worker clocks
                          // are never trusted; the worker treats this as "renew
                          // before you have consumed (expires_at - now_at_receipt)
                          // of local elapsed time" (docs/PROTOCOL.md §5).
}

table Revoke {
  task_id: Uuid;
  reason:  RevokeReason;
}

table PeerList {
  peers: [PeerInfo];
}

table Shutdown {
  reason: string;
}

table Error {
  code:    ErrorCode;
  message: string;
  fatal:   bool;    // true => do not retry with the same state
}

// ── Bidirectional ────────────────────────────────────────────────────────

/// WebRTC signaling, relayed by the coordinator (Phase 6).
///
/// `peer` is the DESTINATION when a worker sends it and the SOURCE when the
/// coordinator forwards it — one shape, direction supplies the meaning.
///
/// `payload` is opaque relayed bytes from another participant. The coordinator
/// MUST NOT parse SDP; it bounds the size and forwards (step 6.1).
table Signal {
  peer:    Uuid;
  payload: [ubyte];
}

// ── STANDING RULE: NO VECTORS OF STRUCTS ─────────────────────────────────
// `[SomeStruct]` is banned in this schema (D-0028). flatbuffers::Verifier
// checks alignment for scalars and for structs inline in a table, but NOT for
// vector-of-struct element data — so such a field is an attacker-craftable
// misaligned read that passes verification.
//
// Vectors of TABLES are fine (tables are offset-addressed, not inline), and so
// are inline struct fields in tables. If you need a packed array of fixed-size
// values, use [ubyte] with an explicit length check — alignment 1 cannot be
// wrong — and re-read D-0028 first.

// ── Envelope ─────────────────────────────────────────────────────────────
// Union member order is wire-visible: the generated `Body` enum numbers them
// in declaration order, starting at NONE = 0. APPEND ONLY.

union Body {
  Hello,
  Welcome,
  BenchmarkRequest,
  BenchmarkResult,
  LeaseRequest,
  TaskGrant,
  LeaseAck,
  Progress,
  ResultHeader,
  Release,
  Revoke,
  Throttle,
  PeerList,
  Signal,
  Goodbye,
  Shutdown,
  Error,
  // APPENDED in D-0077 (step 5.16). Appending is safe; inserting is not —
  // the generated `Body` enum numbers members positionally, so anything but
  // the end silently remaps every existing message (D-0035).
  //
  // These same tables are also members of `AssetBody` below, for Phase 6's
  // peer DataChannel. One description of one thing carried over two
  // transports: Phase 6 changes who SENDS the bytes, not what they look like.
  AssetRequest,
  AssetChunk,
  AssetMiss,
}

table Envelope {
  body: Body;
}

root_type Envelope;

// No `file_identifier`. The fixed frame header already carries a 4-byte magic
// ("P2GP") that is checked before the Verifier ever runs, so a FlatBuffers
// identifier would be a second, weaker copy of a check we already do earlier
// and cheaper (docs/PROTOCOL.md §1).

// ── Data plane (Phase 6) ─────────────────────────────────────────────────
// Peer-supplied bytes are the least trustworthy input in the system — no
// coordinator mediation at all. Bound index/total and use checked arithmetic
// on offsets before touching a buffer (invariant 10, docs/PROTOCOL.md §1).
//
// NOTE: flatc emits VerifyBuffer only for the declared root_type (Envelope).
// The asset path verifies with `verifier.VerifyBuffer<AssetMsg>(nullptr)`,
// which is exactly what the generated helper does internally — see
// src/protocol/verify.cpp. A second root_type is not possible in one schema
// file, and wrapping both in a shared root would put data-plane bytes inside
// the control-plane parser for no benefit.

table AssetRequest {
  hash:       Hash32;
  chunk_from: uint;
  chunk_to:   uint;
}

table AssetChunk {
  hash:  Hash32;
  index: uint;      // MUST be < total, and total MUST equal the expected chunk
  total: uint;      // count for this hash. `index * kChunkBytes` is the classic
  bytes: [ubyte];   // integer-overflow site — checked arithmetic only.
}

table AssetMiss {
  hash: Hash32;
}

union AssetBody { AssetRequest, AssetChunk, AssetMiss }

table AssetMsg {
  body: AssetBody;
}
